# raines.io HTTPS document-root policy. The HTTP virtual host has separate rules.
RewriteEngine On

# Only redirect an explicit request for index.html, not DirectoryIndex resolution.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://raines.io/ [R=301,END]

RewriteCond %{HTTP_HOST} !^raines\.io$ [NC]
RewriteCond %{THE_REQUEST} \s/+([^?\s]*)
RewriteRule ^ https://raines.io/%1 [R=301,END,NE]

# Revalidate documents; existing asset names are mutable, so do not use immutable.
<FilesMatch "\.(?:html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(?:css|js|png|jpe?g|webp|gif|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>
